{
  "_layer": "POLICY (EXAMPLE). Copy to config/documents.json. Defaults are sensible; change the page cap, font, and filename pattern to taste. Nothing here names a person.",
  "_consumed_by": "engine/lib/check_cv.py",
  "_identity_lives_in": [
    "profile/links.json",
    "profile/guardrails.json"
  ],
  "_source": "See QUICKSTART.md step 3.",
  "cv_page_cap": 1.6,
  "cover_letter_page_cap": 1.0,
  "font": "Times New Roman",
  "cv_marker": "_CV_",
  "cover_letter_marker": "_CoverLetter_",
  "filename_pattern": "^\\d{8}_[A-Za-z]+_[A-Za-z]+_(CV|CoverLetter)_v\\d+\\.(docx|pdf)$",
  "filename_max_len": 50,
  "date_format": "^[A-Z][a-z]{2} \\d{4} - [A-Z][a-z]{2} \\d{4}$",
  "banned_date_word": "\\bPresent\\b",
  "bullet_style": "ListParagraph",
  "section_order": [
    "SUMMARY",
    "CORE COMPETENCIES",
    "PROFESSIONAL EXPERIENCE",
    "EDUCATION",
    "ADDITIONAL"
  ],
  "section_headings": {
    "experience": "PROFESSIONAL EXPERIENCE",
    "education": "EDUCATION"
  },
  "links": {
    "min": 8,
    "max": 12,
    "deny_bare_homepage": true
  },
  "keywords": {
    "min": 15,
    "max": 25,
    "repeat_cap": 5,
    "repeat_exempt": [
      "product",
      "products",
      "management",
      "manager",
      "director",
      "senior",
      "lead",
      "leader",
      "leadership",
      "team",
      "teams",
      "platform",
      "platforms",
      "business",
      "strategy",
      "customer",
      "customers",
      "data"
    ],
    "stopwords": [
      "that",
      "this",
      "with",
      "from",
      "have",
      "will",
      "your",
      "their",
      "they",
      "them",
      "there",
      "these",
      "those",
      "than",
      "then",
      "when",
      "what",
      "which",
      "while",
      "were",
      "been",
      "being",
      "into",
      "over",
      "more",
      "most",
      "such",
      "also",
      "each",
      "other",
      "about",
      "across",
      "would",
      "could",
      "should",
      "make",
      "made",
      "work",
      "working",
      "role",
      "team",
      "teams",
      "years",
      "year",
      "help",
      "well",
      "including",
      "ability",
      "strong",
      "experience",
      "candidate",
      "candidates",
      "company",
      "companies",
      "position",
      "opportunity",
      "responsibilities",
      "qualifications",
      "preferred",
      "required",
      "requirements"
    ]
  },
  "folder": {
    "require_webloc": true,
    "allowed_globs": [
      "*_CV_v*.docx",
      "*_CV_v*.pdf",
      "*_CoverLetter_v*.docx",
      "*_CoverLetter_v*.pdf",
      "*outreach plan*.md",
      "*.webloc",
      "*prep*.md",
      "*prep*.docx",
      "*prep*.pdf",
      "*answers*.md",
      "*answers*.docx",
      "*answers*.pdf",
      "*notes*.md"
    ],
    "junk_globs": [
      ".~lock.*#",
      "lu*.tmp",
      "*.tmp",
      "*page-*.jpg",
      "*page-*.jpeg",
      "*page-*.png",
      "~$*",
      "*.bak",
      ".DS_Store",
      "__pycache__",
      "*.pyc"
    ]
  }
}